<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_island_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- 1. Compact Pill State -->
    <LinearLayout
        android:id="@+id/ll_island_compact"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_island_pill"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <View
            android:id="@+id/view_island_compact_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_btn_emerald_pill"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_island_compact_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lexi"
            android:textColor="@color/text_main"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" · "
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_island_compact_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected"
            android:textColor="@color/accent_emerald"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ▾"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- 2. Expanded Capsule State -->
    <LinearLayout
        android:id="@+id/ll_island_expanded"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_island_expanded"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <View
                android:id="@+id/view_island_expanded_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_btn_emerald_pill"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_island_expanded_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✨ Lexi Companion · Arch Linux"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btn_island_collapse"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_titanium_pill"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Quick Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_island_snap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_emerald_pill"
                android:text="📸 Vision"
                android:textColor="#042F24"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_island_clip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_titanium_pill"
                android:text="📋 Clip"
                android:textColor="@color/text_main"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_island_mirror"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_titanium_pill"
                android:text="🚀 Mirror"
                android:textColor="@color/text_main"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_island_beam"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_titanium_pill"
                android:text="⚡ Beam"
                android:textColor="@color/text_main"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
