<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <!-- 1. Top Hardware Telemetry Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_btn_emerald_pill"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_host_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONNECTED · ARCH LINUX (7ms LAN)"
                android:textColor="@color/accent_emerald"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/btn_edit_host"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_btn_titanium_pill"
                android:text="⚙"
                android:textColor="@color/text_muted"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 2. Hero Card: Continuity Camera (Mechanical Iris) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bento_card"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="26dp"
            android:paddingBottom="24dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_camera_iris"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:src="@drawable/ic_lens_iris"
                android:contentDescription="Camera Lens"
                android:layout_marginBottom="22dp" />

            <Button
                android:id="@+id/btn_snap_camera"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_emerald_pill"
                android:text="Capture to Vision Tray"
                android:textColor="#042F24"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- 3. Split Bento Grid (Mirroring + Clipboard) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Left Bento: 60 FPS Screen Mirroring -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_bento_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60 FPS"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Screen Mirroring"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_launch_mirror"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn_titanium_pill"
                    android:text="start mirroring"
                    android:textColor="@color/text_main"
                    android:textSize="12sp"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="screen-off"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <Switch
                        android:id="@+id/sw_stealth_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right Bento: Universal Clipboard -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_bento_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TWO-WAY"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Universal Clipboard"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp" />

                <!-- Text Preview Pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_preview_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_laptop_clip_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ready to sync..."
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_copy_laptop_clip"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_btn_titanium_pill"
                        android:text="Copy"
                        android:textColor="@color/text_main"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_send_phone_clip"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_btn_titanium_pill"
                        android:text="Paste"
                        android:textColor="@color/text_main"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Anchor Base: Zero-Copy Beam Dropzone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dropzone_dashed"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="22dp"
            android:paddingBottom="22dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="··→"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zero-Copy Beam"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_beam_telemetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26.00 MB/s · ↑ 6.12 MB/s  📶"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_pick_files"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_titanium_pill"
                android:text="Choose Files to Beam"
                android:textColor="@color/text_main"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Subtle Footer Branding -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="22dp"
            android:text="Local Wi-Fi Peer-to-Peer · Zero Cloud · Proprietary Protocol"
            android:textColor="@color/text_dim"
            android:textSize="9sp"
            android:letterSpacing="0.02" />

    </LinearLayout>
</ScrollView>
