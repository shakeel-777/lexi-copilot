{
  "manifest_version": 3,
  "name": "Lexi YouTube Bridge",
  "version": "1.1.0",
  "description": "Scoped Native Messaging bridge for Lexi: YouTube playback, and closing only WhatsApp/Instagram tabs. Never runs on other sites.",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtu.be/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtu.be/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
